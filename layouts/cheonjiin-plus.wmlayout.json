{
  "format": "wmkeyboard-layout",
  "version": 1,
  "layout": {
    "id": "asset_ko_cheonjiin_plus",
    "name": "천지인 플러스 (Cheonjiin Plus)",
    "langId": "ko",
    "composer": "CHEONJIIN",
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": "ㅣ",
              "longPress": ["1"]
            },
            {
              "label": "ㆍ",
              "longPress": ["2"]
            },
            {
              "label": "ㅡ",
              "longPress": ["3"]
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              }
            }
          ],
          [
            {
              "label": "ㄱ",
              "longPress": ["4"],
              "width": 0.5
            },
            {
              "label": "ㅋ",
              "longPress": ["ㄲ"],
              "width": 0.5
            },
            {
              "label": "ㄴ",
              "longPress": ["5"],
              "width": 0.5
            },
            {
              "label": "ㄹ",
              "width": 0.5
            },
            {
              "label": "ㄷ",
              "longPress": ["6"],
              "width": 0.5
            },
            {
              "label": "ㅌ",
              "longPress": ["ㄸ"],
              "width": 0.5
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              }
            }
          ],
          [
            {
              "label": "ㅂ",
              "longPress": ["7"],
              "width": 0.5
            },
            {
              "label": "ㅍ",
              "longPress": ["ㅃ"],
              "width": 0.5
            },
            {
              "label": "ㅅ",
              "longPress": ["8"],
              "width": 0.5
            },
            {
              "label": "ㅎ",
              "longPress": ["ㅆ"],
              "width": 0.5
            },
            {
              "label": "ㅈ",
              "longPress": ["9"],
              "width": 0.5
            },
            {
              "label": "ㅊ",
              "longPress": ["ㅉ"],
              "width": 0.5
            },
            {
              "label": ".,",
              "output": ".",
              "longPress": ["-", "'", ":", ";", "~", "…"],
              "multitap": [","],
              "role": "Period"
            },
            {
              "label": "?!",
              "output": "?",
              "longPress": ["-", "'", ":", ";", "~", "…"],
              "multitap": ["!"],
              "role": "Period"
            }
          ],
          [
            {
              "label": "?123",
              "action": {
                "type": "symbols"
              },
              "width": 0.5
            },
            {
              "label": "🌐",
              "action": {
                "type": "language_switch"
              },
              "width": 0.5
            },
            {
              "label": "ㅇ",
              "longPress": ["0"],
              "width": 0.5
            },
            {
              "label": "ㅁ",
              "width": 0.5
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              }
            },
            {
              "label": "?",
              "longPress": ["!", "~", "^", "*", "/"]
            }
          ]
        ]
      }
    }
  }
}
