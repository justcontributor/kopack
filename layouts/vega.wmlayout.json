{
  "format": "wmkeyboard-layout",
  "version": 2,
  "layout": {
    "id": "asset_ko_vega",
    "name": "베가 (Vega)",
    "langId": "ko",
    "composer": "CHEONJIIN",
    "layers": {
      "letters": {
        "rows": [
          [
            {
              "label": "ㄱㅋ",
              "output": "ㄱ",
              "multitap": ["ㅋ", "ㄲ"],
              "longPress": ["1", "!"]
            },
            {
              "label": "ㅣㅡ",
              "output": "ㅣ",
              "multitap": ["ㅡ"],
              "longPress": ["2", "@"]
            },
            {
              "label": "ㅏㅑ",
              "output": "ㅏ",
              "multitap": ["ㅑ"],
              "longPress": ["3", "#"]
            },
            {
              "label": "⌫",
              "action": {
                "type": "delete"
              }
            }
          ],
          [
            {
              "label": "ㄷㅌ",
              "output": "ㄷ",
              "multitap": ["ㅌ", "ㄸ"],
              "longPress": ["4", "$"]
            },
            {
              "label": "ㄴㄹ",
              "output": "ㄴ",
              "multitap": ["ㄹ"],
              "longPress": ["5", "%"]
            },
            {
              "label": "ㅓㅕ",
              "output": "ㅓ",
              "multitap": ["ㅕ"],
              "longPress": ["6", "^"]
            },
            {
              "label": " ",
              "action": {
                "type": "space"
              }
            }
          ],
          [
            {
              "label": "ㅁㅅ",
              "output": "ㅁ",
              "multitap": ["ㅅ", "ㅆ"],
              "longPress": ["7", "&"]
            },
            {
              "label": "ㅂㅍ",
              "output": "ㅂ",
              "multitap": ["ㅍ", "ㅃ"],
              "longPress": ["8", "*"]
            },
            {
              "label": "ㅗㅛ",
              "output": "ㅗ",
              "multitap": ["ㅛ"],
              "longPress": ["9", "("]
            },
            {
              "label": ".",
              "output": ".",
              "longPress": [",", "!", "?", "-", "'", ":", ";", "~", "…"],
              "role": "Period",
              "width": 0.5
            },
            {
              "label": "⏎",
              "action": {
                "type": "enter"
              },
              "width": 0.5
            }
          ],
          [
            {
              "label": "ㅈㅊ",
              "output": "ㅈ",
              "multitap": ["ㅊ", "ㅉ"],
              "longPress": ["*"]
            },
            {
              "label": "ㅇㅎ",
              "output": "ㅇ",
              "multitap": ["ㅎ"],
              "longPress": ["0", ")"]
            },
            {
              "label": "ㅜㅠ",
              "output": "ㅜ",
              "multitap": ["ㅠ"],
              "longPress": ["#"]
            },
            {
              "label": "?123",
              "action": {
                "type": "symbols"
              },
              "width": 0.5
            },
            {
              "label": "🌐",
              "action": {
                "type": "language_switch"
              },
              "width": 0.5
            }
          ]
        ]
      }
    }
  }
}
